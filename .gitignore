# ---- Go ----
# compiled binaries (built via CI/scripts, never committed)
/spike/agent-spike
/node-agent/node-agent
/node-agent/nodespeed-agent
/central/central
*.exe
*.test
*.out

# ---- Node / frontend ----
node_modules/
/frontend/dist/
# frontend built into central via go:embed (copied from frontend/dist at build);
# keep only the placeholder so the embed pattern still matches
/central/webroot/*
!/central/webroot/.gitkeep
.vite/
*.local

# ---- secrets & certs (NEVER commit) ----
*.pem
*.key
*.crt
*.cer
*.env
!*.example.env
secrets/
*.secret
# real node config holds per-node secrets; only the example is committed
/central/nodes.json

# ---- spike throwaway artifacts ----
/spike/results/

# ---- tooling / editor ----
.claude/
.DS_Store
.idea/
.vscode/

# ---- misc ----
*.log
*.db
*.gob
